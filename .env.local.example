# ============================================================
# AethLife — Environment Variables
# Copy this file to .env.local for local development.
# Add each variable to Vercel Dashboard → Project → Settings → Environment Variables for production.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Groq AI — 4-Key Rotation ─────────────────────────────────
# Get free keys at: console.groq.com/keys
# Create up to 4 separate Groq accounts for maximum free capacity.
# All 4 keys rotate automatically — if one hits rate limit, next is tried.
GROQ_API_KEY_1=gsk_key1_from_groq_account_1
GROQ_API_KEY_2=gsk_key2_from_groq_account_2
GROQ_API_KEY_3=gsk_key3_from_groq_account_3
GROQ_API_KEY_4=gsk_key4_from_groq_account_4

# ── Firebase (Push Notifications ONLY — not for hosting) ─────
# AethLife uses Firebase ONLY for push notifications (FCM).
# Hosting is handled by Vercel.
# Get from: console.firebase.google.com → Project Settings → General → Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
# Get from: Project Settings → Cloud Messaging → Web configuration → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BHv...

# ── Resend Email ─────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_...

# ── App URL ──────────────────────────────────────────────────
# Use your Vercel URL until you connect aethlife.xyz
NEXT_PUBLIC_APP_URL=https://aethlife.vercel.app

# ── NOWPayments Crypto Payments ──────────────────────────────
# nowpayments.io → Store Settings → API Keys → Generate
# Add your API key (format: XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX)
NOWPAYMENTS_API_KEY=JASDFYJ-SJYMFNV-QWW6EME-QDE84QY

# nowpayments.io → Store Settings → IPN Secret → Generate
# Only shown ONCE — save it securely
NOWPAYMENTS_IPN_SECRET=ieqi6w1bv9e8oZWEgHgA4MPhBCQbvu1/

# Webhook URL to paste in NOWPayments Store Settings → IPN Callback URL:
# https://aethlife.vercel.app/api/webhooks/payment

# ── Promo Code ───────────────────────────────────────────────
PROMO_CODE=AETHTEST2025
PROMO_CODE_EXPIRES=2026-12-31T23:59:59Z

# ── EmailJS (Bug Report & Feedback System) ───────────────────
# Setup: emailjs.com → Add Service (Gmail) → Create Template
# Template variables needed: from_name, from_email, to_email,
# bug_type, bug_title, bug_description, rating, page_url,
# user_agent, screenshot
# Get these from: emailjs.com → Account → API Keys
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
